# Server-only secrets. Copy to .env locally; set these in your host's secret settings in production.
QLOO_API_KEY=
# Hackathon keys use the hackathon host. Change only if Qloo tells you to.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Max Qloo calls per user run (cache hits are free).
QLOO_CALL_BUDGET=40
# Optional: enables the "plain LLM, no Qloo" baseline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
